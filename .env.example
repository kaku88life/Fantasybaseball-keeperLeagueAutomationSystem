# ===================================================
# Fantasy Baseball Keeper League - Environment Variables
# Copy this file to .env and fill in your values
# ===================================================

# --- Database ---
# PostgreSQL connection string (production)
# DATABASE_URL=postgresql://user:password@host:5432/keeper_league
# Leave unset for local development (defaults to local PostgreSQL)

# --- Authentication ---
# JWT secret key (REQUIRED for production - use a random 32+ character string)
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# --- Yahoo Fantasy API OAuth2 ---
YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here
YAHOO_LEAGUE_ID=469.l.80910

# OAuth redirect URI (must match Yahoo Developer Console settings)
# Local:      http://localhost:8002/api/auth/yahoo/callback
# Production: https://YOUR-BACKEND.zeabur.app/api/auth/yahoo/callback
OAUTH_REDIRECT_URI=http://localhost:8002/api/auth/yahoo/callback

# --- Frontend URL ---
# Used for post-login redirect
# Local:      http://localhost:3001
# Production: https://YOUR-FRONTEND.zeabur.app
FRONTEND_URL=http://localhost:3001

# --- CORS ---
# Comma-separated list of additional allowed origins (production frontend URL)
# ALLOWED_ORIGINS=https://5man-keeperleague.zeabur.app

# --- Optional: Future Features ---
# Anthropic API (AI Weekly Summaries)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- LINE Bot Group Notification ---
# Required for keeper deadline reminders (Phase 10-1)
# Get from LINE Developers Console: https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_GROUP_ID=your_line_group_id

# --- Keeper Reminder Scheduler ---
# Annual window mode (default, works every year automatically):
# Reminders are sent during REMINDER_MONTH, from START_DAY to END_DAY.
# REMINDER_MONTH=3          # Month number (default: 3 = March)
# REMINDER_START_DAY=1      # Start day of month (default: 1)
# REMINDER_END_DAY=15       # End day of month (default: 15)
#
# Legacy mode: explicit date range (overrides annual window if set)
# KEEPER_REMINDER_START=2026-03-01
# KEEPER_REMINDER_END=2026-03-22
#
# Common settings:
# REMINDER_CRON_HOUR=12       # Hour to check (0-23, default: 12 = noon)
# REMINDER_CRON_TZ=Asia/Taipei  # Timezone (default: Asia/Taipei)
# REMINDER_INTERVAL_DAYS=3   # Days between reminders (default: 3)

# --- Rookie Call-up Monitor ---
# Monitors R-contract players for MLB debuts, sends LINE notification.
# Runs daily at REMINDER_CRON_HOUR during MLB season months.
# ROOKIE_MONITOR_ENABLED=true           # Enable/disable (default: true)
# ROOKIE_MONITOR_START_MONTH=3          # Start month (default: 3 = March)
# ROOKIE_MONITOR_END_MONTH=9            # End month (default: 9 = September)

# --- Deprecated: SMTP Email (replaced by LINE in Phase 10-1) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
